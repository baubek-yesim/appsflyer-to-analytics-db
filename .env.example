# Copy to .env and fill in real values. .env is gitignored — never commit it.
# On the server, these same keys are provided via a systemd EnvironmentFile instead
# (see deploy/appsflyer-daily.service + docs/RUNBOOK.md).

# --- Analytics database (MariaDB/MySQL) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=analytics_statistics
DB_TABLE=appsflyer_events_fb
DB_TABLE_INSTALLS=appsflyer_installs_fb

# --- AppsFlyer Pull API ---
# API token/key — get from Mark Malovichko (see BAF-2 comment).
APPSFLYER_API_TOKEN=
# Comma-separated AppsFlyer app IDs to pull. OPTIONAL (issue #48): defaults to
# the production roster com.yesimmobile,id1458505230 when unset. Leaving the
# line present-but-empty is an error (issue #9) — set it or keep it commented.
#APPSFLYER_APP_IDS=com.yesimmobile,id1458505230

# --- Run parameters ---
# Which registered reports a backfill/daily run may fetch (BAF-11 stage 4).
# Default when unset: in_app_events_non_organic,in_app_events_retargeting --
# i.e. the two installs reports are registered and their table is provisioned
# by `create-table`, but NO run pulls them. Naming them here is how an operator
# manually opts a run into installs:
#   APPSFLYER_ENABLED_REPORTS=installs_non_organic,installs_retargeting
# Keep it unset (or in-app-events-only) for the deployed scheduled timer until
# the real cutover decision. Valid keys: in_app_events_non_organic,
# in_app_events_retargeting, installs_non_organic, installs_retargeting -- an
# unknown key aborts the run loudly rather than silently pulling nothing.
#APPSFLYER_ENABLED_REPORTS=in_app_events_non_organic,in_app_events_retargeting
# BOTH filters below are three-valued (BAF-11 stage 1):
#   present with a value  -> filter (BAF-2's scope; this is what you want)
#   absent / commented out -> NO filter: the FULL raw export, every media source
#                             and every event name, into whatever DB_TABLE names
#   present but empty      -> startup error, deliberately (issue #9)
# Removing a line does NOT fall back to a default — it widens the pull.
# Media source filter applied to both API pulls.
APPSFLYER_MEDIA_SOURCE=Facebook Ads
# Comma-separated event names to keep.
APPSFLYER_EVENT_NAMES=af_purchase,af_purchase_YC
# Trailing window the flagless `daily` run re-pulls, in days (issue #8): 1 =
# yesterday only (default), 3 = recommended in production -- re-captures
# AppsFlyer's late/offline-cached events at zero extra report-download quota
# (still one download per report per run, as long as it stays <= chunk size).
#APPSFLYER_DAILY_LOOKBACK_DAYS=3
# Optional event-time window for the flagless `daily` run (issue #50): maps
# straight onto the API's from/to (which filter on event time). FROM required
# for TO; TO defaults to yesterday. CAUTION: a standing FROM older than the
# API's ~35-day availability floor meets valid-looking EMPTY responses and the
# idempotent delete-then-insert would wipe already-loaded rows (issue #45).
#APPSFLYER_EVENT_TIME_FROM=2026-06-04
#APPSFLYER_EVENT_TIME_TO=2026-07-08
# Timezone AppsFlyer expresses reports in (issue #53): unset = UTC. When set,
# event times AND the from/to day boundaries follow this zone. Production uses
# Europe/Riga — the analytics team's reference exports are in that zone and UTC
# pulls land 3 hours behind them. Must match the app-level timezone setting in
# AppsFlyer exactly; a malformed zone name fails startup loudly, a
# valid-but-wrong one cannot be caught client-side.
#APPSFLYER_TIMEZONE=Europe/Riga
